# Copy to .env.local (gitignored). Every value here is server-side only: the /api functions read
# them (set the same names as Vercel environment variables in production). The browser gets none.
APP_URL=http://localhost:5173
# true = Claude, SerpAPI and Dropbox return fixtures (no keys needed, nothing written to Dropbox).
MOCK_EXTERNAL=true

# Airtable — the app's database (personal access token with data.records:read/write and
# schema.bases:read/write on the base)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=

# Anthropic
ANTHROPIC_API_KEY=

# SerpAPI
SERPAPI_API_KEY=

# Dropbox (scoped app, offline refresh token: fill KEY/SECRET, then `npm run dropbox:connect`)
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Login cookies (any long random string; changing it signs everyone out)
SESSION_SECRET=
# Vercel Cron sends "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# ---------- Later phases ----------
# Bannerbear
BANNERBEAR_API_KEY=
BANNERBEAR_WEBHOOK_SECRET=

# Email (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM="TrueU Content Cockpit <cockpit@trueu.ai>"

# Approval links (HMAC key for tokens)
APPROVAL_TOKEN_SECRET=

# Make.com webhooks, one per platform (the URL is the credential: keep it private; set the same in Vercel)
MAKE_WEBHOOK_FACEBOOK=
MAKE_WEBHOOK_INSTAGRAM=
MAKE_WEBHOOK_TIKTOK=
MAKE_WEBHOOK_YOUTUBE_SHORTS=
MAKE_WEBHOOK_YOUTUBE_LONG=
MAKE_WEBHOOK_THREADS=
MAKE_WEBHOOK_TWITTER=
MAKE_WEBHOOK_PINTEREST=
# Shared secret: sent to Make as X-Cockpit-Secret, and required on Make's callbacks to the app
MAKE_WEBHOOK_SECRET=

# Optional — only if the app publishes blog/newsletter directly (OQ-5)
WP_URL=
WP_USER=
WP_APP_PASSWORD=
AC_API_URL=
AC_API_KEY=

